# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Production
/dist

# Environment / secrets
#
# .env.example is ignored too, and deliberately: it is a private scratch file
# for real environment values, not a committed template. The variables the app
# actually reads are documented in docs/environment.md, which carries no
# secrets. A file whose whole purpose is to hold credentials must never be
# tracked, however harmless its name sounds.
.env
.env*.local
.env.production
.env.example

# Supabase
supabase/.branches
supabase/.temp
**/supabase/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Editors / OS
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Office temp/lock files
~$*
*.tmp

# Claude local settings (keep shared settings.json, ignore local overrides)
.claude/settings.local.json

# Subagent-driven-development scratch
.superpowers/

# Playwright MCP scratch output
.playwright-mcp/
