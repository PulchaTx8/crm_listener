node_modules
.next
.git
docs
Arte
tests
*.md
# No exception for .env.example. It used to be un-ignored here so the image
# could carry the template, but it now holds real environment values — and the
# `COPY . .` in the builder stage would bake them into an image layer, where
# gitignoring them protects nothing.
.env*

# Test runner configs. They are not needed in the image, and they import from
# `tests/`, which is excluded above — leaving them in makes `next build` fail
# inside the container on a module the image deliberately does not ship.
playwright.config.ts
vitest.config.ts
vitest.isolation.config.ts
playwright-report
test-results
.playwright-mcp
supabase
