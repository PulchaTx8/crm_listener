NODE_ENV=development

# --- BUILD-TIME (obrigatórias no build da imagem) ------------------------------
# NEXT_PUBLIC_* são inlined no bundle do cliente durante o `next build`. No
# EasyPanel elas precisam ir na aba de **Build args** (o Dockerfile as declara
# como ARG no estágio builder); defini-las só em Environment/runtime NÃO altera
# um bundle já compilado. Também precisam existir em runtime, para o código de
# servidor — no EasyPanel, informe nos dois lugares.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- RUNTIME-ONLY (nunca como build arg) ---------------------------------------
# Segredo de servidor. Build args ficam gravados nas camadas da imagem, então
# esta chave só pode existir na aba Environment (runtime) do EasyPanel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opcional (notificações do app) — runtime
SMTP_URL=smtp://user:pass@host:587
MAIL_FROM=crm@example.com

# --- NUNCA definir em runtime --------------------------------------------------
# SKIP_ENV_VALIDATION=1 existe apenas dentro do estágio builder do Dockerfile,
# porque durante o `next build` os segredos legitimamente não existem. Se essa
# variável vazar para o ambiente de runtime do EasyPanel, `src/lib/env.ts` cai no
# ramo frouxo (`parseLooseEnv`), a validação de boot desaparece em silêncio e o
# contêiner sobe sem nenhuma configuração de Supabase — falhando só na primeira
# query, em produção, em vez de falhar no boot.
